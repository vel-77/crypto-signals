# =================================================================================================
# Copy to .env and adjust. Every value here has a working default, so an unedited copy still runs.
# =================================================================================================

# ---- database ----------------------------------------------------------------------------------
POSTGRES_DB=cryptosignals
POSTGRES_USER=cryptosignals
# Change this before exposing the database port anywhere but localhost.
POSTGRES_PASSWORD=cryptosignals
POSTGRES_PORT=5432

# ---- ports -------------------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---- what to watch -----------------------------------------------------------------------------
# The watch list is the cross product: 2 symbols x 3 timeframes = 6 independent analyses.
SYMBOLS=BTCUSDT,ETHUSDT
TIMEFRAMES=15m,30m,1h
# 24h / 7d / 30d / 90d / 365d. Use 0 for all available history (a long first backfill).
LOOKBACK=30d

# ---- detection rules ---------------------------------------------------------------------------
# Read docs/ALGORITHM.md before changing these; the defaults are calibrated for ~5m candles and
# should be widened for 4h and above.
MIN_TOUCHES=3
TOUCH_TOLERANCE_PERCENT=0.1
BREAKOUT_TOLERANCE_PERCENT=0.2
MIN_CANDLES_BETWEEN_TOUCHES=10
CONFIRMATION_CANDLES=1
# true: a level signals on its 3rd touch and again on every further touch (4th, 5th, ...).
# false: each level signals exactly once, on its 3rd touch.
SIGNAL_ON_EVERY_TOUCH=true
# Supersede rules hide a level in favour of a nearby level of the same kind (status SUPERSEDED,
# not broken). SUPERSEDE_ENABLED switches both off at once.
SUPERSEDE_ENABLED=true
# Proximity: levels with 3+ touches whose neighbouring gaps are all within the gap below form one
# group; only the highest resistance / lowest support of the group stays active, at any price.
SUPERSEDE_NEARBY_LEVELS=true
# Price: once price is past a level and a level with 3+ touches just beyond it is nearer to
# price, the passed level is retired.
SUPERSEDE_ON_PRICE_PASS=true
# Gap within which two levels count as the same price area, per timeframe, in percent.
SUPERSEDE_MAX_DISTANCE=15m:0.5,30m:0.6,1h:0.75,4h:1.5

# ---- Telegram ----------------------------------------------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
# Leaving TELEGRAM_ENABLED=false keeps the channel off; signals still land in the log and the API.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Times in Telegram messages. Each person picks their own time zone in the web interface.
NOTIFICATIONS_TIMEZONE=UTC

# ---- misc --------------------------------------------------------------------------------------
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
